{
  "productName": "Broomed",
  "version": "0.1.0",
  "identifier": "com.broomed.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Broomed",
        "width": 1100,
        "height": 750,
        "visible": false
      },
      {
        "label": "widget",
        "url": "widget.html",
        "width": 200,
        "height": 180,
        "minWidth": 180,
        "minHeight": 160,
        "maxWidth": 500,
        "maxHeight": 600,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.broomed.app https://auth.broomed.app https://manage.broomed.app https://*.broomed.app http://localhost:* http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources"]
  }
}
