{
  "productName": "Broomed",
  "version": "0.1.0",
  "identifier": "com.broomed.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Broomed",
        "width": 1100,
        "height": 750,
        "visible": false
      },
      {
        "label": "widget",
        "url": "widget.html",
        "width": 260,
        "height": 180,
        "minWidth": 200,
        "minHeight": 160,
        "maxWidth": 420,
        "maxHeight": 600,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources"]
  }
}
