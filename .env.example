# Broomed - Environment Example
# Copy to .env and fill in values: cp .env.example .env
# This project is local-first with embedded AI; no local server required.
# Most config lives in app settings / Rust core.

# Embedded local AI is the default - no setup required.
# Models are managed automatically under your OS app data directory.
# Override only for testing:
# BROOMED_MODEL_DIR=/path/to/models
# BROOMED_FORCE_GPU=1

# Optional cloud AI providers (explicit opt-in only, never required for local functionality)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Tauri dev (optional)
# TAURI_DEBUG=false
