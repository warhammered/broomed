# Broomed - Environment Example
# Copy to .env and fill in values: cp .env.example .env
# This project is local-first; most config lives in app settings / Rust core.
# Only set provider keys if you use cloud AI features.

# Ollama (local LLM) - default http://localhost:11434
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional cloud AI providers (only if enabled in app settings)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Tauri dev (optional)
# TAURI_DEBUG=false
